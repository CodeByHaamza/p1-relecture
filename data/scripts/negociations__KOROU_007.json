{"zone": "negociations", "nom": "KOROU_007", "repliques": [{"id": "KOROU.BIN:text:0607", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " ...Well, you cast your line, and now"}, {"nl": "{SAUT}"}, {"t": "I'm hooked. Please, tell me..."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": " ...Bon, tu as lancé ta ligne, et me"}, {"nl": "{SAUT}"}, {"t": "voilà ferré. Allez, dis-moi..."}, {"nl": "(*RESPONSE*)"}], "brut_en": " ...Well, you cast your line, and now{SAUT}I'm hooked. Please, tell me...(*RESPONSE*)", "brut_fr": " ...Bon, tu as lancé ta ligne, et me{SAUT}voilà ferré. Allez, dis-moi...(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0608", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "Oooh! Excellent move! That one was"}, {"nl": "{SAUT}"}, {"t": "incredible!"}, {"nl": "{ATTENTE}"}], "fr": [{"t": "Oooh! Beau tour de passe-passe! Celui-là"}, {"nl": "{SAUT}"}, {"t": "était incroyable!"}, {"nl": "{ATTENTE}"}], "brut_en": "Oooh! Excellent move! That one was{SAUT}incredible!{ATTENTE}", "brut_fr": "Oooh! Beau tour de passe-passe! Celui-là{SAUT}était incroyable!{ATTENTE}", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0609", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"nl": "{PAGE}"}, {"t": "If you showed me more things like that,"}, {"nl": "{SAUT}"}, {"t": "I wouldn't need to know!"}, {"nl": "(*RESPONSE*)"}], "fr": [{"nl": "{PAGE}"}, {"t": "Si tu me montrais plus de choses comme"}, {"nl": "{SAUT}"}, {"t": "ça, j'aurais pas besoin de savoir!"}, {"nl": "(*RESPONSE*)"}], "brut_en": "{PAGE}If you showed me more things like that,{SAUT}I wouldn't need to know!(*RESPONSE*)", "brut_fr": "{PAGE}Si tu me montrais plus de choses comme{SAUT}ça, j'aurais pas besoin de savoir!(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0610", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   Wh-What the!? What in tarnation are you"}, {"nl": "{SAUT}"}, {"t": "yelling for!?"}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "   Qu-Quoi donc!? Pourquoi diable tu"}, {"nl": "{SAUT}"}, {"t": "cries comme ça!?"}, {"nl": "(*RESPONSE*)"}], "brut_en": "   Wh-What the!? What in tarnation are you{SAUT}yelling for!?(*RESPONSE*)", "brut_fr": "   Qu-Quoi donc!? Pourquoi diable tu{SAUT}cries comme ça!?(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0611", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "  Th-That wasn't it...? Sorry, didn't mean"}, {"nl": "{SAUT}"}, {"t": "to be suspicious. Will you keep going?"}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "  C-C'était pas ça...? Désolé, je voulais"}, {"nl": "{SAUT}"}, {"t": "pas me méfier. Tu continues?"}, {"nl": "(*RESPONSE*)"}], "brut_en": "  Th-That wasn't it...? Sorry, didn't mean{SAUT}to be suspicious. Will you keep going?(*RESPONSE*)", "brut_fr": "  C-C'était pas ça...? Désolé, je voulais{SAUT}pas me méfier. Tu continues?(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0612", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "Hoho. You're like a carriage horse."}, {"nl": "{SAUT}"}, {"t": "Being dedicated is a good thing."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "Hoho. Tu es comme un cheval de trait."}, {"nl": "{SAUT}"}, {"t": "Être dévoué, c'est une bonne chose."}, {"nl": "(*RESPONSE*)"}], "brut_en": "Hoho. You're like a carriage horse.{SAUT}Being dedicated is a good thing.(*RESPONSE*)", "brut_fr": "Hoho. Tu es comme un cheval de trait.{SAUT}Être dévoué, c'est une bonne chose.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0613", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   Why...? Nothing good comes from living"}, {"nl": "{SAUT}"}, {"t": "a rebellious life."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "   Pourquoi...? Rien de bon ne sort d'une"}, {"nl": "{SAUT}"}, {"t": "vie de rébellion."}, {"nl": "(*RESPONSE*)"}], "brut_en": "   Why...? Nothing good comes from living{SAUT}a rebellious life.(*RESPONSE*)", "brut_fr": "   Pourquoi...? Rien de bon ne sort d'une{SAUT}vie de rébellion.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0614", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "  That makes me happy. You look like a"}, {"nl": "{SAUT}"}, {"t": "lie, but you're a good kid."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "  Ça me fait plaisir. Tu as l'air d'un"}, {"nl": "{SAUT}"}, {"t": "menteur, mais tu es un bon gamin."}, {"nl": "(*RESPONSE*)"}], "brut_en": "  That makes me happy. You look like a{SAUT}lie, but you're a good kid.(*RESPONSE*)", "brut_fr": "  Ça me fait plaisir. Tu as l'air d'un{SAUT}menteur, mais tu es un bon gamin.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0615", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   Hmph! You have all the free time in the"}, {"nl": "{SAUT}"}, {"t": "world! If you don't want to, say so!"}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "   Hmph! Tu as tout le temps du monde!"}, {"nl": "{SAUT}"}, {"t": "Si tu veux pas, dis-le!"}, {"nl": "(*RESPONSE*)"}], "brut_en": "   Hmph! You have all the free time in the{SAUT}world! If you don't want to, say so!(*RESPONSE*)", "brut_fr": "   Hmph! Tu as tout le temps du monde!{SAUT}Si tu veux pas, dis-le!(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0616", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   Ho, ho! Then let's negotiate!"}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "   Ho, ho! Alors négocions!"}, {"nl": "(*RESPONSE*)"}], "brut_en": "   Ho, ho! Then let's negotiate!(*RESPONSE*)", "brut_fr": "   Ho, ho! Alors négocions!(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0617", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "  I'm not so much a demon as I am a"}, {"nl": "{SAUT}"}, {"j": "[FFF0]"}, {"t": "..."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "  Je suis moins un démon qu'un"}, {"nl": "{SAUT}"}, {"j": "[FFF0]"}, {"t": "..."}, {"nl": "(*RESPONSE*)"}], "brut_en": "  I'm not so much a demon as I am a{SAUT}[FFF0]...(*RESPONSE*)", "brut_fr": "  Je suis moins un démon qu'un{SAUT}[FFF0]...(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0618", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " I happen to be on a stroll too."}, {"nl": "{SAUT}"}, {"t": "I think you and I could get along."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": " Il se trouve que je me promène aussi."}, {"nl": "{SAUT}"}, {"t": "Je crois qu'on pourrait s'entendre."}, {"nl": "(*RESPONSE*)"}], "brut_en": " I happen to be on a stroll too.{SAUT}I think you and I could get along.(*RESPONSE*)", "brut_fr": " Il se trouve que je me promène aussi.{SAUT}Je crois qu'on pourrait s'entendre.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0619", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " It's too late now. No sense cryin' over"}, {"nl": "{SAUT}"}, {"t": "spilt milk."}, {"nl": "{ATTENTE}"}], "fr": [{"t": " C'est trop tard. Pas la peine de"}, {"nl": "{SAUT}"}, {"t": "pleurer sur le lait renversé."}, {"nl": "{ATTENTE}"}], "brut_en": " It's too late now. No sense cryin' over{SAUT}spilt milk.{ATTENTE}", "brut_fr": " C'est trop tard. Pas la peine de{SAUT}pleurer sur le lait renversé.{ATTENTE}", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0620", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"nl": "{PAGE}"}, {"t": "Be careful next time."}, {"nl": "(*RESPONSE*)"}], "fr": [{"nl": "{PAGE}"}, {"t": "Fais attention la prochaine fois."}, {"nl": "(*RESPONSE*)"}], "brut_en": "{PAGE}Be careful next time.(*RESPONSE*)", "brut_fr": "{PAGE}Fais attention la prochaine fois.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0621", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " What are you complaining about? It's"}, {"nl": "{SAUT}"}, {"t": "first come, first serve for things like"}, {"nl": "{SAUT}"}, {"t": "this."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": " De quoi tu te plains? C'est premier"}, {"nl": "{SAUT}"}, {"t": "arrivé, premier servi pour ce genre"}, {"nl": "{SAUT}"}, {"t": "de chose."}, {"nl": "(*RESPONSE*)"}], "brut_en": " What are you complaining about? It's{SAUT}first come, first serve for things like{SAUT}this.(*RESPONSE*)", "brut_fr": " De quoi tu te plains? C'est premier{SAUT}arrivé, premier servi pour ce genre{SAUT}de chose.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0622", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " Ahhhh! Stop it! It's gonna stink like"}, {"nl": "{SAUT}"}, {"t": "humans...! Noooo, it's done for!"}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": " Ahhhh! Arrête! Ça va puer l'humain...!"}, {"nl": "{SAUT}"}, {"t": "Nooon, c'est fichu!"}, {"nl": "(*RESPONSE*)"}], "brut_en": " Ahhhh! Stop it! It's gonna stink like{SAUT}humans...! Noooo, it's done for!(*RESPONSE*)", "brut_fr": " Ahhhh! Arrête! Ça va puer l'humain...!{SAUT}Nooon, c'est fichu!(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0623", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " Hey! That's a child's answer! Don't toy"}, {"nl": "{SAUT}"}, {"t": "with me!"}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": " Hé! C'est une réponse d'enfant! Joue"}, {"nl": "{SAUT}"}, {"t": "pas avec moi!"}, {"nl": "(*RESPONSE*)"}], "brut_en": " Hey! That's a child's answer! Don't toy{SAUT}with me!(*RESPONSE*)", "brut_fr": " Hé! C'est une réponse d'enfant! Joue{SAUT}pas avec moi!(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0624", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   Is that so!? That's downright cruel!"}, {"nl": "{SAUT}"}, {"t": "But I want to eat it too..."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "   Ah bon!? C'est carrément cruel!"}, {"nl": "{SAUT}"}, {"t": "Mais j'en veux aussi..."}, {"nl": "(*RESPONSE*)"}], "brut_en": "   Is that so!? That's downright cruel!{SAUT}But I want to eat it too...(*RESPONSE*)", "brut_fr": "   Ah bon!? C'est carrément cruel!{SAUT}Mais j'en veux aussi...(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0625", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   ...I don't get it..."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "   ...Je comprends pas..."}, {"nl": "(*RESPONSE*)"}], "brut_en": "   ...I don't get it...(*RESPONSE*)", "brut_fr": "   ...Je comprends pas...(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0626", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   The more ya have to suck out, the more"}, {"nl": "{SAUT}"}, {"t": "flavorful it gets! That's dried squid!"}, {"nl": "{SAUT}"}, {"t": "Delicious, I say!"}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "   Plus il y a à sucer, plus ça a de"}, {"nl": "{SAUT}"}, {"t": "goût! C'est le calmar séché!"}, {"nl": "{SAUT}"}, {"t": "Délicieux, je te dis!"}, {"nl": "(*RESPONSE*)"}], "brut_en": "   The more ya have to suck out, the more{SAUT}flavorful it gets! That's dried squid!{SAUT}Delicious, I say!(*RESPONSE*)", "brut_fr": "   Plus il y a à sucer, plus ça a de{SAUT}goût! C'est le calmar séché!{SAUT}Délicieux, je te dis!(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0627", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "Hey! My teeth ain't what they used to"}, {"nl": "{SAUT}"}, {"t": "be! I can't eat such hard food!"}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "Hé! Mes dents sont plus ce qu'elles"}, {"nl": "{SAUT}"}, {"t": "étaient! Je mange pas si dur!"}, {"nl": "(*RESPONSE*)"}], "brut_en": "Hey! My teeth ain't what they used to{SAUT}be! I can't eat such hard food!(*RESPONSE*)", "brut_fr": "Hé! Mes dents sont plus ce qu'elles{SAUT}étaient! Je mange pas si dur!(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0628", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "  I don't need that."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "  J'ai pas besoin de ça."}, {"nl": "(*RESPONSE*)"}], "brut_en": "  I don't need that.(*RESPONSE*)", "brut_fr": "  J'ai pas besoin de ça.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0629", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " Hey! It's obvious ya don't wanna!"}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": " Hé! C'est évident que tu veux pas!"}, {"nl": "(*RESPONSE*)"}], "brut_en": " Hey! It's obvious ya don't wanna!(*RESPONSE*)", "brut_fr": " Hé! C'est évident que tu veux pas!(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0630", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "  That's right. Now there's a good"}, {"nl": "{SAUT}"}, {"t": "attitude."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "  C'est ça. Voilà une bonne"}, {"nl": "{SAUT}"}, {"t": "attitude."}, {"nl": "(*RESPONSE*)"}], "brut_en": "  That's right. Now there's a good{SAUT}attitude.(*RESPONSE*)", "brut_fr": "  C'est ça. Voilà une bonne{SAUT}attitude.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0631", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " If you're just gonna ignore me, why'd"}, {"nl": "{SAUT}"}, {"t": "you answer my first question!? I don't"}, {"nl": "{SAUT}"}, {"t": "understand..."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": " Si tu veux juste m'ignorer, pourquoi"}, {"nl": "{SAUT}"}, {"t": "tu as répondu à ma première question!?"}, {"nl": "{SAUT}"}, {"t": "Je comprends pas..."}, {"nl": "(*RESPONSE*)"}], "brut_en": " If you're just gonna ignore me, why'd{SAUT}you answer my first question!? I don't{SAUT}understand...(*RESPONSE*)", "brut_fr": " Si tu veux juste m'ignorer, pourquoi{SAUT}tu as répondu à ma première question!?{SAUT}Je comprends pas...(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0632", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " Ho ho. You young'uns don't understand"}, {"nl": "{SAUT}"}, {"t": "the emotion of a moonless night."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": " Ho ho. Vous les jeunes, vous comprenez"}, {"nl": "{SAUT}"}, {"t": "pas l'émotion d'une nuit sans lune."}, {"nl": "(*RESPONSE*)"}], "brut_en": " Ho ho. You young'uns don't understand{SAUT}the emotion of a moonless night.(*RESPONSE*)", "brut_fr": " Ho ho. Vous les jeunes, vous comprenez{SAUT}pas l'émotion d'une nuit sans lune.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0633", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " A moonless night makes surprise attacks"}, {"nl": "{SAUT}"}, {"t": "easy... You're plannin' somethin'..."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": " Une nuit sans lune rend les attaques"}, {"nl": "{SAUT}"}, {"t": "surprises faciles... Tu prépares un coup..."}, {"nl": "(*RESPONSE*)"}], "brut_en": " A moonless night makes surprise attacks{SAUT}easy... You're plannin' somethin'...(*RESPONSE*)", "brut_fr": " Une nuit sans lune rend les attaques{SAUT}surprises faciles... Tu prépares un coup...(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0634", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   That's really strange. You and I both"}, {"nl": "{SAUT}"}, {"t": "have more to learn."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "   C'est vraiment étrange. Toi et moi"}, {"nl": "{SAUT}"}, {"t": "avons encore à apprendre."}, {"nl": "(*RESPONSE*)"}], "brut_en": "   That's really strange. You and I both{SAUT}have more to learn.(*RESPONSE*)", "brut_fr": "   C'est vraiment étrange. Toi et moi{SAUT}avons encore à apprendre.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0635", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "  ...I've never played this game you're"}, {"nl": "{SAUT}"}, {"t": "goin' on about..."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "  ...J'ai jamais joué à ce jeu dont tu"}, {"nl": "{SAUT}"}, {"t": "parles..."}, {"nl": "(*RESPONSE*)"}], "brut_en": "  ...I've never played this game you're{SAUT}goin' on about...(*RESPONSE*)", "brut_fr": "  ...J'ai jamais joué à ce jeu dont tu{SAUT}parles...(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0636", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "...I've heard of that before, but"}, {"nl": "{SAUT}"}, {"t": "where...?"}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "...J'ai déjà entendu ça, mais"}, {"nl": "{SAUT}"}, {"t": "où...?"}, {"nl": "(*RESPONSE*)"}], "brut_en": "...I've heard of that before, but{SAUT}where...?(*RESPONSE*)", "brut_fr": "...J'ai déjà entendu ça, mais{SAUT}où...?(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0637", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "You're mischief. You don't have to tease"}, {"nl": "{SAUT}"}, {"t": "me, do ya? Come on, do somethin'."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "Tu es un garnement. Tu as pas besoin de"}, {"nl": "{SAUT}"}, {"t": "me taquiner, si? Allez, fais un truc."}, {"nl": "(*RESPONSE*)"}], "brut_en": "You're mischief. You don't have to tease{SAUT}me, do ya? Come on, do somethin'.(*RESPONSE*)", "brut_fr": "Tu es un garnement. Tu as pas besoin de{SAUT}me taquiner, si? Allez, fais un truc.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0638", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " Argh! You ain't gonna listen!?"}, {"nl": "{ATTENTE}"}], "fr": [{"t": " Argh! Tu vas pas écouter!?"}, {"nl": "{ATTENTE}"}], "brut_en": " Argh! You ain't gonna listen!?{ATTENTE}", "brut_fr": " Argh! Tu vas pas écouter!?{ATTENTE}", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0639", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"nl": "{PAGE}"}, {"t": "Time to put a rebellious boy in his"}, {"nl": "{SAUT}"}, {"t": "place!"}, {"nl": "(*RESPONSE*)"}], "fr": [{"nl": "{PAGE}"}, {"t": "Il est temps de remettre un garçon"}, {"nl": "{SAUT}"}, {"t": "rebelle à sa place!"}, {"nl": "(*RESPONSE*)"}], "brut_en": "{PAGE}Time to put a rebellious boy in his{SAUT}place!(*RESPONSE*)", "brut_fr": "{PAGE}Il est temps de remettre un garçon{SAUT}rebelle à sa place!(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0640", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " You're obedient... But after seein'"}, {"nl": "{SAUT}"}, {"t": "those eyes of yours, I can't trust ya..."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": " Tu es obéissant... Mais après avoir vu"}, {"nl": "{SAUT}"}, {"t": "tes yeux, je peux pas te croire..."}, {"nl": "(*RESPONSE*)"}], "brut_en": " You're obedient... But after seein'{SAUT}those eyes of yours, I can't trust ya...(*RESPONSE*)", "brut_fr": " Tu es obéissant... Mais après avoir vu{SAUT}tes yeux, je peux pas te croire...(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0641", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   Hey! You're not supposed to interrupt!"}, {"nl": "{ATTENTE}"}], "fr": [{"t": "   Hé! On coupe pas la parole!"}, {"nl": "{ATTENTE}"}], "brut_en": "   Hey! You're not supposed to interrupt!{ATTENTE}", "brut_fr": "   Hé! On coupe pas la parole!{ATTENTE}", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0642", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"nl": "{PAGE}"}, {"t": "If ya can't wait for someone to finish"}, {"nl": "{SAUT}"}, {"t": "talkin', I'll have to punish you!"}, {"nl": "(*RESPONSE*)"}], "fr": [{"nl": "{PAGE}"}, {"t": "Si tu peux pas attendre qu'on finisse"}, {"nl": "{SAUT}"}, {"t": "de parler, je vais devoir te punir!"}, {"nl": "(*RESPONSE*)"}], "brut_en": "{PAGE}If ya can't wait for someone to finish{SAUT}talkin', I'll have to punish you!(*RESPONSE*)", "brut_fr": "{PAGE}Si tu peux pas attendre qu'on finisse{SAUT}de parler, je vais devoir te punir!(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0643", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   Ho, ho! How brazenly you speak!"}, {"nl": "{SAUT}"}, {"t": "Interesting! Let's negotiate."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "   Ho, ho! Quelle effronterie dans tes"}, {"nl": "{SAUT}"}, {"t": "mots! Intéressant! Négocions."}, {"nl": "(*RESPONSE*)"}], "brut_en": "   Ho, ho! How brazenly you speak!{SAUT}Interesting! Let's negotiate.(*RESPONSE*)", "brut_fr": "   Ho, ho! Quelle effronterie dans tes{SAUT}mots! Intéressant! Négocions.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0644", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "  I'll give ya the ol' one-two! Don't be"}, {"nl": "{SAUT}"}, {"t": "talkin' that hogwash!"}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "  Je vais te servir une leçon! Arrête"}, {"nl": "{SAUT}"}, {"t": "de dire des âneries!"}, {"nl": "(*RESPONSE*)"}], "brut_en": "  I'll give ya the ol' one-two! Don't be{SAUT}talkin' that hogwash!(*RESPONSE*)", "brut_fr": "  Je vais te servir une leçon! Arrête{SAUT}de dire des âneries!(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0645", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   ...Oh well."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "   ...Tant pis."}, {"nl": "(*RESPONSE*)"}], "brut_en": "   ...Oh well.(*RESPONSE*)", "brut_fr": "   ...Tant pis.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0646", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "That's right! Now that I think about it,"}, {"nl": "{SAUT}"}, {"t": "I feel like we've met before..."}, {"nl": "{ATTENTE}"}], "fr": [{"t": "C'est ça! Maintenant que j'y pense,"}, {"nl": "{SAUT}"}, {"t": "j'ai l'impression qu'on s'est vus..."}, {"nl": "{ATTENTE}"}], "brut_en": "That's right! Now that I think about it,{SAUT}I feel like we've met before...{ATTENTE}", "brut_fr": "C'est ça! Maintenant que j'y pense,{SAUT}j'ai l'impression qu'on s'est vus...{ATTENTE}", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0647", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"nl": "{PAGE}"}, {"t": "Sorry, all you humans look alike..."}, {"nl": "(*RESPONSE*)"}], "fr": [{"nl": "{PAGE}"}, {"t": "Désolé, vous les humains vous ressemblez..."}, {"nl": "(*RESPONSE*)"}], "brut_en": "{PAGE}Sorry, all you humans look alike...(*RESPONSE*)", "brut_fr": "{PAGE}Désolé, vous les humains vous ressemblez...(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0648", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "  Ho, ho! It's just a human. I got all"}, {"nl": "{SAUT}"}, {"t": "worried over nothin'."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "  Ho, ho! C'est juste un humain. Je me"}, {"nl": "{SAUT}"}, {"t": "suis inquiété pour rien."}, {"nl": "(*RESPONSE*)"}], "brut_en": "  Ho, ho! It's just a human. I got all{SAUT}worried over nothin'.(*RESPONSE*)", "brut_fr": "  Ho, ho! C'est juste un humain. Je me{SAUT}suis inquiété pour rien.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0649", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": " ...Yer really a demon? You smell sorta"}, {"nl": "{SAUT}"}, {"t": "human..."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": " ...Tu es vraiment un démon? Tu sens un"}, {"nl": "{SAUT}"}, {"t": "peu l'humain..."}, {"nl": "(*RESPONSE*)"}], "brut_en": " ...Yer really a demon? You smell sorta{SAUT}human...(*RESPONSE*)", "brut_fr": " ...Tu es vraiment un démon? Tu sens un{SAUT}peu l'humain...(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:text:0650", "bloc": "KOROU.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "...Yer really a demon? You smell sorta"}, {"nl": "{SAUT}"}, {"t": "human..."}, {"nl": "(*RESPONSE*)"}], "fr": [{"t": "...Tu es vraiment un démon? Tu sens un"}, {"nl": "{SAUT}"}, {"t": "peu l'humain..."}, {"nl": "(*RESPONSE*)"}], "brut_en": "...Yer really a demon? You smell sorta{SAUT}human...(*RESPONSE*)", "brut_fr": "...Tu es vraiment un démon? Tu sens un{SAUT}peu l'humain...(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:resp:0001", "bloc": "KOROU.BIN:resp", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "You have a role."}, {"nl": "(*RESPONSE*)"}, {"t": "   "}], "fr": [{"t": "Tu as un rôle."}, {"nl": "(*RESPONSE*)"}], "brut_en": "You have a role.(*RESPONSE*)   ", "brut_fr": "Tu as un rôle.(*RESPONSE*)", "japonais": false, "technique": false}, {"id": "KOROU.BIN:resp:0002", "bloc": "KOROU.BIN:resp", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "I'll put you to use."}, {"nl": "(*RESPONSE*)"}, {"t": "   "}], "fr": [{"t": "Je vais t'employer."}