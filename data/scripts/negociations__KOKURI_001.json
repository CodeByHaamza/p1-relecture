TION*)"}], "fr": [{"t": "＊ouaf＊ Pas d'humeur à utiliser la"}, {"nl": "{SAUT}"}, {"t": "planche cette fois, alors je te donne"}, {"nl": "{SAUT}"}, {"t": "juste ma carte."}, {"j": "(*OPTION*)"}], "brut_en": "   ＊yip＊ I'm not in the mood to use the{SAUT}board this time, so I'll just give you{SAUT}my card.(*OPTION*)", "brut_fr": "＊ouaf＊ Pas d'humeur à utiliser la{SAUT}planche cette fois, alors je te donne{SAUT}juste ma carte.(*OPTION*)", "japonais": false, "technique": false}, {"id": "KOKURI.BIN:text:0174", "bloc": "KOKURI.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   You seem pretty amazing for a human."}, {"nl": "{SAUT}"}, {"t": "Let's just talk like normal."}, {"j": "(*OPTION*)"}], "fr": [{"t": "T'as l'air plutôt génial pour un humain."}, {"nl": "{SAUT}"}, {"t": "Parlons normalement."}, {"j": "(*OPTION*)"}], "brut_en": "   You seem pretty amazing for a human.{SAUT}Let's just talk like normal.(*OPTION*)", "brut_fr": "T'as l'air plutôt génial pour un humain.{SAUT}Parlons normalement.(*OPTION*)", "japonais": false, "technique": false}, {"id": "KOKURI.BIN:text:0175", "bloc": "KOKURI.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "  ＊yip＊ Not only that, I'll give you my"}, {"nl": "{SAUT}"}, {"t": "card, too. Gracious, aren't I?"}, {"j": "(*OPTION*)"}], "fr": [{"t": "＊ouaf＊ En plus, je te donne ma carte"}, {"nl": "{SAUT}"}, {"t": "aussi. Généreux, non?"}, {"j": "(*OPTION*)"}], "brut_en": "  ＊yip＊ Not only that, I'll give you my{SAUT}card, too. Gracious, aren't I?(*OPTION*)", "brut_fr": "＊ouaf＊ En plus, je te donne ma carte{SAUT}aussi. Généreux, non?(*OPTION*)", "japonais": false, "technique": false}, {"id": "KOKURI.BIN:text:0176", "bloc": "KOKURI.BIN:text", "occ": 1, "loc": "", "loc_en": "", "portrait": "", "en": [{"t": "   ...L-I-K-E... I-T... A... L-O-T..."}, {"j": "(*OPTION*)"}], "fr": [{"t": "...A-I-M-E... B-E-A-U-C-O-U-P..."}, {"j": "(*OPTION*)"}], "brut_en": "   ...L-I-K-E... I-T... A... L-O-T...(*OPTION*)"